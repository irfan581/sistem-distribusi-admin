APP_NAME="Presensi TMK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── DATABASE ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_tmk
DB_USERNAME=root
DB_PASSWORD=

# ─── SESSION ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── BROADCASTING (WebSocket Reverb) ──────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=presensi-tmk
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── QUEUE ────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── CACHE ────────────────────────────────────────────────────
CACHE_STORE=database

# ─── FILESYSTEM ───────────────────────────────────────────────
FILESYSTEM_DISK=public

# ─── MAIL ─────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.mailpit.test
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@presensi-example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── REDIS (opsional, untuk cache/queue lebih cepat) ──────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── SANCTUM ──────────────────────────────────────────────────
# Untuk Vue SPA: tambahkan domain frontend
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── ABSENSI ──────────────────────────────────────────────────
ABSENSI_BATAS_JAM=08:00
ABSENSI_MIN_KUNJUNGAN=3
ABSENSI_TOKEN_EXPIRY=6

# ─── FIREBASE (Push Notification FCM) ────────────────────────
FIREBASE_CREDENTIALS=
# Path ke file JSON service account Firebase
# Contoh: FIREBASE_CREDENTIALS=/var/www/presensi-tmk/firebase-credentials.json
FIREBASE_PROJECT_ID=

# ─── TELESCOPE (Dev Only) ─────────────────────────────────────
TELESCOPE_ENABLED=true

# ─── NOMOR KANTOR ─────────────────────────────────────────────
# Ditelepon driver dan dibuka di WhatsApp oleh sales saat ada tujuan
# bermasalah. Format internasional tanpa spasi, mis. +6281234567890.
# Dikosongkan berarti tombol hubungi kantor tidak muncul sama sekali.
DRIVER_NOMOR_ADMIN=

# Grup chat penerima laporan bongkar driver, dibuat lewat
# `php artisan chat:grup-laporan`. Dikosongkan = penerusan dimatikan.
DRIVER_GRUP_LAPORAN_ID=
